      "description": "Runs workflow every minute.",
      "timeout_seconds": 90,
      "tools": []
    },
    {
      "id": "fetch_score",
      "agent": "research_agent",
      "name": "Fetch Score",
      "description": "Retrieve live cricket score from Cricbuzz API.",
      "timeout_seconds": 90,
      "tools": []
    },
    {
      "id": "analyze_score",
      "agent": "reasoning_agent",
      "name": "Analyze Score",
      "description": "Detect interesting events like sixes or wickets.",
      "timeout_seconds": 90,
      "tools": []
    },
    {
      "id": "event_check",
      "agent": "logic_condition",
      "name": "Event Check",
      "description": "Branch on whether an interesting event occurred.",
      "timeout_seconds": 90,
      "tools": []
    },
    {
      "id": "compose_email",
      "agent": "drafting_agent",
      "name": "Compose Email",
      "description": "Generate alert email content.",
      "timeout_seconds": 90,
      "tools": []
    },
    {
      "id": "send_email",
      "agent": "tool_gmail",
      "name": "Send Email",
      "description": "Send alert via Gmail.",
      "timeout_seconds": 90,
      "tools": []
    },
    {
      "id": "noop",
      "agent": "code_transform",
      "name": "Noop",
      "description": "Do nothing when no event.",
      "timeout_seconds": 90,
      "tools": []
    }
  ],
  "edges": [
