# ═══════════════════════════════════════════════════════════════════════════════
# OpsGrid Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://opsgrid:opsgrid_dev_password@localhost:5434/opsgrid
POSTGRES_PASSWORD=opsgrid_dev_password

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:opsgrid_redis_dev@localhost:6379/0
REDIS_PASSWORD=opsgrid_redis_dev

# ─── LLM API Keys ──────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Get from: https://platform.openai.com
OPENAI_API_KEY=sk-...

# Get from: https://aistudio.google.com
GOOGLE_API_KEY=...

# Get from: https://console.groq.com
GROQ_API_KEY=gsk_...

# ─── Application ───────────────────────────────────────────────────────────────
ENVIRONMENT=development           # development | staging | production
SECRET_KEY=change_this_to_a_random_secret_in_production
DEBUG=true
LOG_LEVEL=INFO

# ─── EPI Recorder ──────────────────────────────────────────────────────────────
EPI_EVIDENCE_DIR=./evidence       # Where .epi files are stored
EPI_AUTO_RECORD=true              # Auto-record all LLM calls

# ─── Admin Control Panel ───────────────────────────────────────────────────────
ADMIN_REFRESH_RATE=2              # Dashboard refresh rate in seconds

# ─── Integration Credentials (per-tenant, stored in DB) ────────────────────────
# These are set per-client in the config, not here.
# See config/templates/saas.json for the structure.

# ─── Optional: Override LLM Models ─────────────────────────────────────────────
# You can override the default model assignments here.
# See config/templates/llm_config.json for full model config.
LLM_HEAVY_MODEL=anthropic/claude-sonnet-4-20250514
LLM_FAST_MODEL=groq/llama-3.1-8b-instant
LLM_MINI_MODEL=anthropic/claude-haiku-4-5-20251001




# ─── Admin Credentials (Super Admin — change in production) ────────────────────
ADMIN_EMAIL=admin@opsgrid.io
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=OpsGrid Admin
 
# ─── RAG / Embedding Settings ──────────────────────────────────────────────────
# Set to "true" to use local sentence-transformers (free, offline)
# Set to "false" to use OpenAI embeddings (requires OPENAI_API_KEY)
PREFER_LOCAL_EMBEDDINGS=true
 
# Local embedding model (downloaded automatically on first use, ~90MB)
# Options: all-MiniLM-L6-v2 (384-dim, fast), all-mpnet-base-v2 (768-dim, better quality)
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
 
# ─── Vector DB Dimension ──────────────────────────────────────────────────────
# Must match your embedding model's output dimension
# all-MiniLM-L6-v2 → 384, all-mpnet-base-v2 → 768, OpenAI text-embedding-3-small → 1536
EMBEDDING_DIM=384
VAULT_ENCRYPTION_KEY=generate using python

VITE_API_BASE=http://127.0.0.1:8000/api/v1

HUGGINGFACE_API_KEY=hf_...
# Token location: https://huggingface.co/settings/tokens
# The token is used by LiteLLM automatically when calling:
# model="huggingface/meta-llama/Meta-Llama-3-8B-Instruct"