# ─────────────────────────────────────────────────────────────────────────────
# SMBFlow frontend environment
# Copy to `.env` (or `.env.local`) to override the built-in defaults.
# These are the ONLY frontend env vars the app reads (see src/api/client.js).
# No secrets belong here — the JWT is never stored on disk or in env.
# ─────────────────────────────────────────────────────────────────────────────

# Base URL for the FastAPI HTTP API (must include the /api/v1 prefix).
VITE_API_BASE=http://127.0.0.1:8000/api/v1

# Base URL for the WebSocket endpoint (session id is appended: /{session_id}?token=...).
VITE_WS_BASE=http://127.0.0.1:8000/ws
